{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myagent.local/schemas/myagent-plugin-v1.schema.json",
  "title": "MyAgent Plugin Manifest v1",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable plugin identifier and namespace."
    },
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "author": {
      "oneOf": [
        {"type": "string"},
        {"type": "object"},
        {"type": "array"}
      ]
    },
    "skills": {"$ref": "#/$defs/pathList"},
    "hooks": {"$ref": "#/$defs/pathList"},
    "agents": {"$ref": "#/$defs/pathList"},
    "prompts": {"$ref": "#/$defs/pathList"},
    "commands": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "items": {"type": "string"}
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "properties": {
                  "content": {"type": "string"},
                  "source": {"type": "string"},
                  "description": {"type": "string"},
                  "argumentHint": {"type": "string"},
                  "argument_hint": {"type": "string"}
                },
                "additionalProperties": true
              }
            ]
          }
        }
      ]
    },
    "slash_commands": {"$ref": "#/properties/commands"},
    "mcp_servers": {},
    "dependencies": {
      "type": "object",
      "properties": {
        "python": {
          "oneOf": [
            {"type": "null"},
            {"type": "boolean"},
            {"type": "array", "items": {"type": "string"}},
            {
              "type": "object",
              "properties": {
                "packages": {"type": "array", "items": {"type": "string"}},
                "requirements": {"type": "string"}
              },
              "additionalProperties": false
            }
          ]
        },
        "node": {},
        "plugins": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "oneOf": [
        {"type": "object"},
        {"type": "array", "items": {"type": "string"}}
      ]
    },
    "runtime": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["entrypoint"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["python", "py", "node", "nodejs", "javascript", "js"]
            },
            "entrypoint": {"type": "string", "minLength": 1},
            "api_version": {"const": "1"},
            "timeout_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 600
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "pathList": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["path"],
                "properties": {"path": {"type": "string"}},
                "additionalProperties": true
              }
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
