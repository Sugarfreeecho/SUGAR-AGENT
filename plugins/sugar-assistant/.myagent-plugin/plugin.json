{
  "schema_version": 1,
  "id": "sugar-assistant",
  "name": "小Sugar助手",
  "version": "0.2.0",
  "description": "统一 IM 接入：一套 Core 管会话映射、幂等投递、身份分级与提问/审批，各家只写一个薄 Adapter。",
