{
  "schema_version": 1,
  "id": "agent-team",
  "name": "Agent Team",
  "version": "1.0.0",
  "system_builtin": true,
  "description": "Optional multi-session collaboration workflow.",
  "capabilities": {
    "trusted_host": {
      "entry": "host.py"
    },
    "web": {
      "entry": "web/index.html",
      "assets": "web"
    },
    "ui": {
      "session.badge": [
        {
          "id": "active-team",
          "namespace": "team",
          "path": "/status",
          "label": "Team",
          "variant": "info",
          "when": "equals",
          "equals": "active"
        }
      ],
      "settings.section": [
        {
          "id": "main",
          "title": "Agent Team 团队",
          "description": "管理当前会话的成员、共享任务与协作消息",
          "target": "renderer",
          "order": 60,
          "renderer": {
            "module": "settings.js",
            "style": "settings.css"
          }
        }
      ]
    }
  }
}
