# SugarAgent environment example
# Copy this file to app/.env and fill in your own secrets.

# --- Legacy model bootstrap (one-time import only) ---
# On startup these fields are copied once into model_profiles.json. Runtime model
# selection uses the imported profile, not .env. New installations should prefer
# the browser model-profile wizard; these entries may be removed after import.
EXECUTOR_LLM_TYPE=auto
EXECUTOR_LLM=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Optional legacy model tuning (also imported into the profile)
CONTEXT_WINDOW=65536
MAX_OUTPUT_TOKENS=8192
EXECUTOR_TEMPERATURE=0.7
OPENAI_HTTP_TIMEOUT=300
# 官方 OpenAI Responses WebSocket：auto/enabled 仅允许 *.openai.com，disabled 关闭。
# 自定义 Responses 代理始终使用 HTTP/SSE，避免把 SDK 的 connect() 误当成端点能力。
RESPONSES_WEBSOCKET_MODE=auto
# 显式可重试错误路径的尝试数（含首次）；所有尝试仍受统一总预算限制。
OPENAI_MAX_RETRIES=4
# 慢响应并行抢跑阈值（秒）：普通单模型 Chat Completions 在传输层等待首个有效 token；
# 由 Executor facade 统一管理模型回退时禁用并行 hedge，避免每条物理请求重复切换模型。
# 非流式调用只在上层缓冲赢家结果。达到阈值仍无 token 时追加请求；设为 0 关闭。
OPENAI_FIRST_TOKEN_HEDGE_TIMEOUT_SEC=30
# 单次逻辑模型调用因慢响应最多追加的 hedge 请求数，不含最初的主请求；
# 默认 2 表示最多形成“1 路主请求 + 2 路 hedge”。设为 0 禁止追加 hedge。
OPENAI_FIRST_TOKEN_HEDGE_MAX_RETRIES=2
# 单次逻辑模型调用允许发出的物理 API 请求总数。主请求、hedge、显式错误重试、
# 备用模型候选、媒体降级重发和 stream_options 兼容重发都会计数；达到上限后不再发新请求。
OPENAI_TOTAL_REQUEST_BUDGET=6
# 单次逻辑模型调用从首个请求开始计算的总时限（秒），覆盖所有并行 hedge、
# 错误重试和备用模型切换；到期后主流程停止等待。它不是单个 HTTP 请求的超时。
OPENAI_TOTAL_DEADLINE_SEC=600
# 同一逻辑模型调用中同时运行的 API 请求连接上限；限制并行度，不限制累计请求总数。
# 默认 3 与“1 路主请求 + 最多 2 路 hedge”一致。
OPENAI_MAX_INFLIGHT_REQUESTS=3
NETWORK_RECONNECT_MAX_ATTEMPTS=5
LOCAL_NETWORK_POLL_SECONDS=5
OPENAI_RETRY_BASE_SEC=1.0

# Legacy local model bootstrap, for EXECUTOR_LLM_TYPE=local
LOCAL_LLM_HOST=http://localhost:11434
LOCAL_LLM=qwen3.5:9b

# --- Paths ---
WORK_DIR=../workspace
SKILLS_DIR=../workspace/skills
LOG_DIR=../logs

# --- Agent behavior ---
MAX_REACT_ITER=100
SUBAGENT_MAX_DEPTH=1
SUBAGENT_MAX_REACT_ITER=100
SUBAGENT_BEST_OF_N=3
VERBOSE_LOGGING=True
# Keep full prompts/responses for every ReAct round only while diagnosing.
LLM_FULL_CALL_TRACE=0
# Coalesce subsequent text deltas within one browser frame; first token is immediate.
LLM_STREAM_COALESCE_MS=12
# Debounce whole-file observability rewrites; terminal state always flushes immediately.
EXECUTION_METRICS_FLUSH_DELAY_MS=200
RUNTIME_OBSERVABILITY_FLUSH_DELAY_MS=200
RUNTIME_OBSERVABILITY_FULL_SCAN_SECONDS=60
TODO_MAX_ITEMS=30
MAX_PARALLEL_TOOLS=10

# Three-level system pressure controller. Busy keeps token streaming; severe
# pressure keeps upstream streaming, buffers whole-response UI output, and limits local resource tools.
CPU_PRESSURE_ENABLED=true
CPU_PRESSURE_BUSY_PERCENT=60
CPU_PRESSURE_SEVERE_PERCENT=90
CPU_PRESSURE_RECOVERY_PERCENT=65
CPU_PRESSURE_SAMPLE_SECONDS=10
CPU_PRESSURE_ENTER_SAMPLES=12
CPU_PRESSURE_RECOVERY_SECONDS=120
CPU_PRESSURE_TOOL_CONCURRENCY=2
SECURITY_ENABLED=1
# 系统出站助手：1=启用并自动发现/调用，0=完全关闭助手（仅保留应用层审批识别）。
EGRESS_HELPER_ENABLED=1
ASK_USER_ENABLED=1
GOAL_ENABLED=1

# ls only scans recognized text/source files up to this per-file byte limit.
LS_INCLUDE_LINE_COUNTS=1
LS_LINE_COUNT_MAX_BYTES=5242880

# File change audit: off=disabled (default), git=Git worktree status only,
# full=walk the whole workspace.
FILE_AUDIT_MODE=off

# --- Hooks / Plugins ---
# Both feature switches default to enabled. Set either to 0/false/no/off to disable it.
HOOKS_ENABLED=1
HOOKS_PATH=
STOP_HOOK_MAX_RETRIES=3
PLUGINS_ENABLED=1
PLUGINS_DIR=../workspace/plugins
PLUGINS_STATE_PATH=../workspace/.myagent/plugins-state.json

# --- Web search ---
# Providers: duckduckgo, brave, tavily, searxng, jina
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=20
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=
JINA_API_KEY=

# --- MCP ---
MCP_ENABLED=1
MCP_SERVERS_PATH=
MCP_SERVERS_JSON=
# Unified registration approval for MCP servers and executable plugin tools,
# hooks, and commands. 0 registers directly; 1 requires digest-bound approval.
EXTENSION_REGISTRATION_APPROVAL_ENABLED=0
MCP_UI_APPROVAL=1
MCP_UI_APPROVAL_ALLOW_REGEX=

# --- Tool approval / shell behavior ---
TOOL_UI_APPROVAL=1
TOOL_UI_APPROVAL_WAIT_SEC=3600
RUN_SHELL_INHERIT_SECRET_ENV=0
RUN_SHELL_PYTHON_UNBUFFERED=1
RUN_SHELL_FORCE_UTF8=1
RUN_SHELL_USE_BASH=
RUN_SHELL_BASH=
RUN_SHELL_POWERSHELL=

# --- HTTP / proxy / downloads ---
HTTPS_PROXY=
HTTP_PROXY=
WEB_FETCH_MAX_REDIRECTS=5
WEB_DOWNLOAD_MAX_BYTES=26214400

# --- UI / runtime flags ---
OPEN_BROWSER=True
# Frontend UI version: v1=legacy execution process block, v2=redesigned block.
# Restart SugarAgent after changing it.
MYAGENT_FRONTEND_VERSION=v1
CHAT_SSE_KEEPALIVE_SEC=15
CHAT_ACTIVE_TIMEOUT_SEC=300
RUNTIME_V2_ORPHAN_GRACE_SEC=0
MYAGENT_ENABLE_FOLLOWUP_RESTART=1
# Default mode for Send now: append waits for the next ReAct request; interrupt replans immediately.
MYAGENT_STEER_MODE=append
MYAGENT_ENABLE_STREAM_RECONNECT=1
MYAGENT_ENABLE_FINAL_RECONCILE=1
# Silky per-frame LLM reveal and live bottom-follow. Restart after changing.
# 0 preserves the legacy immediate delta flush and scroll-to-bottom behavior.
MYAGENT_SMOOTH_STREAM_ENABLED=0
# Show Windows system notifications (Action Center toasts) when the last WebUI
# tab is closed, a conversation finishes, or pending approvals/questions need
# attention while no WebUI tab is visible and focused. Falls back to a native
# message box if the system notification API is unavailable. Clicking a toast
# opens the WebUI through the
# sugaragent:// URL protocol. 0 disables all of them.
MYAGENT_UI_CLOSED_NOTIFY=1
# Grace window in seconds; refresh or reopening the UI inside this window cancels it.
MYAGENT_UI_CLOSED_NOTIFY_DELAY_SEC=3
# How long a UI tab may go without a heartbeat before it is considered closed.
MYAGENT_UI_PRESENCE_TTL_SEC=300
RUNTIME_VERSION=2
RUNTIME_V2_STRICT=0
# Only online ReAct writes use a lock timeout; migration/repair stays unbounded.
RUNTIME_V2_REACT_TRANSACTION_TIMEOUT_SECONDS=10
RUNTIME_V2_SLOW_LOCK_WARNING_SECONDS=2
# Keep rebuildable snapshot fsync/replace work outside the ReAct request path.
RUNTIME_V2_ASYNC_SNAPSHOT_CHECKPOINTS=true
RUNTIME_V2_SNAPSHOT_CHECKPOINT_EVENTS=32
RUNTIME_V2_SNAPSHOT_WORKERS=2
RUNTIME_V2_SNAPSHOT_LOCK_TIMEOUT_SECONDS=30
# Let normal checkpoints finish inline; slow ones detach after this grace.
RUNTIME_V2_SNAPSHOT_INLINE_GRACE_MS=10

# --- Remote Control ---
# Hard startup switch. Disabled by default; change requires restarting SugarAgent.
MYAGENT_REMOTE_CONTROL_ENABLED=0

# --- Feishu bot (outbound WebSocket long connection) ---
# Disabled by default. Create a Feishu custom app, enable its bot, then fill in credentials.
FEISHU_ENABLED=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional comma-separated allowlists. Leaving both empty allows every app-visible user/chat.
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_CHAT_IDS=
# Group messages must @ the bot by default.
FEISHU_GROUP_REQUIRE_MENTION=1
# chat: one SugarAgent session per chat; thread: one session per Feishu thread when available.
FEISHU_SESSION_SCOPE=chat
FEISHU_RESPONSE_TIMEOUT_SEC=7200
FEISHU_MAX_REPLY_CHARS=3500
FEISHU_STATE_DIR=
