# SugarAgent environment example
# Copy this file to app/.env and fill in your own secrets.

# --- Legacy model bootstrap (one-time import only) ---
# On startup these fields are copied once into model_profiles.json. Runtime model
# selection uses the imported profile, not .env. New installations should prefer
# the browser model-profile wizard; these entries may be removed after import.
EXECUTOR_LLM_TYPE=openai
EXECUTOR_LLM=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Optional legacy model tuning (also imported into the profile)
CONTEXT_WINDOW=65536
MAX_OUTPUT_TOKENS=8192
EXECUTOR_TEMPERATURE=0.7
OPENAI_HTTP_TIMEOUT=600
OPENAI_MAX_RETRIES=3
NETWORK_RECONNECT_MAX_ATTEMPTS=5
LOCAL_NETWORK_POLL_SECONDS=5
OPENAI_RETRY_BASE_SEC=1.0

# Legacy local model bootstrap, for EXECUTOR_LLM_TYPE=local
LOCAL_LLM_HOST=http://localhost:11434
LOCAL_LLM=qwen3.5:9b

# --- Paths ---
WORK_DIR=../workspace
SKILLS_DIR=../workspace/skills
LOG_DIR=../logs

# --- Agent behavior ---
MAX_REACT_ITER=100
SUBAGENT_MAX_DEPTH=1
SUBAGENT_MAX_REACT_ITER=100
SUBAGENT_BEST_OF_N=3
VERBOSE_LOGGING=True
TODO_MAX_ITEMS=30
MAX_PARALLEL_TOOLS=10
SECURITY_ENABLED=0
ASK_USER_ENABLED=1
GOAL_ENABLED=1

# --- Hooks / Plugins ---
# Both feature switches default to enabled. Set either to 0/false/no/off to disable it.
HOOKS_ENABLED=1
HOOKS_PATH=
STOP_HOOK_MAX_RETRIES=3
PLUGINS_ENABLED=1
PLUGINS_DIR=../workspace/plugins
PLUGINS_STATE_PATH=../workspace/.myagent/plugins-state.json

# --- Web search ---
# Providers: duckduckgo, brave, tavily, searxng, jina
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=20
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=
JINA_API_KEY=

# --- MCP ---
MCP_ENABLED=1
MCP_SERVERS_PATH=
MCP_SERVERS_JSON=
MCP_UI_APPROVAL=1
MCP_UI_APPROVAL_ALLOW_REGEX=

# --- Tool approval / shell behavior ---
TOOL_UI_APPROVAL=1
TOOL_UI_APPROVAL_WAIT_SEC=3600
RUN_SHELL_INHERIT_SECRET_ENV=0
RUN_SHELL_PYTHON_UNBUFFERED=1
RUN_SHELL_FORCE_UTF8=1
RUN_SHELL_USE_BASH=
RUN_SHELL_BASH=
RUN_SHELL_POWERSHELL=

# --- HTTP / proxy / downloads ---
HTTPS_PROXY=
HTTP_PROXY=
WEB_FETCH_MAX_REDIRECTS=5
WEB_DOWNLOAD_MAX_BYTES=26214400

# --- UI / runtime flags ---
OPEN_BROWSER=True
CHAT_SSE_KEEPALIVE_SEC=15
CHAT_ACTIVE_TIMEOUT_SEC=300
RUNTIME_V2_ORPHAN_GRACE_SEC=0
MYAGENT_ENABLE_FOLLOWUP_RESTART=1
# Default mode for Send now: append waits for the next ReAct request; interrupt replans immediately.
MYAGENT_STEER_MODE=append
MYAGENT_ENABLE_STREAM_RECONNECT=1
MYAGENT_ENABLE_FINAL_RECONCILE=1
# Show Windows system notifications (Action Center toasts) when the last WebUI
# tab is closed, a conversation finishes, or pending approvals/questions need
# attention while no WebUI tab is visible and focused. Falls back to a tray
# balloon / message box. Clicking a toast opens the WebUI through the
# sugaragent:// URL protocol. 0 disables all of them.
MYAGENT_UI_CLOSED_NOTIFY=1
# Grace window in seconds; refresh or reopening the UI inside this window cancels it.
MYAGENT_UI_CLOSED_NOTIFY_DELAY_SEC=3
# How long a UI tab may go without a heartbeat before it is considered closed.
MYAGENT_UI_PRESENCE_TTL_SEC=300
RUNTIME_VERSION=2
RUNTIME_V2_STRICT=0
# Only online ReAct writes use a lock timeout; migration/repair stays unbounded.
RUNTIME_V2_REACT_TRANSACTION_TIMEOUT_SECONDS=10
RUNTIME_V2_SLOW_LOCK_WARNING_SECONDS=2
# Keep rebuildable snapshot fsync/replace work outside the ReAct request path.
RUNTIME_V2_ASYNC_SNAPSHOT_CHECKPOINTS=true
RUNTIME_V2_SNAPSHOT_CHECKPOINT_EVENTS=32
RUNTIME_V2_SNAPSHOT_WORKERS=2
RUNTIME_V2_SNAPSHOT_LOCK_TIMEOUT_SECONDS=30
# Let normal checkpoints finish inline; slow ones detach after this grace.
RUNTIME_V2_SNAPSHOT_INLINE_GRACE_MS=50

# --- Remote Control ---
# Hard startup switch. Disabled by default; change requires restarting SugarAgent.
MYAGENT_REMOTE_CONTROL_ENABLED=0

# --- Feishu bot (outbound WebSocket long connection) ---
# Disabled by default. Create a Feishu custom app, enable its bot, then fill in credentials.
FEISHU_ENABLED=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional comma-separated allowlists. Leaving both empty allows every app-visible user/chat.
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_CHAT_IDS=
# Group messages must @ the bot by default.
FEISHU_GROUP_REQUIRE_MENTION=1
# chat: one SugarAgent session per chat; thread: one session per Feishu thread when available.
FEISHU_SESSION_SCOPE=chat
FEISHU_RESPONSE_TIMEOUT_SEC=7200
FEISHU_MAX_REPLY_CHARS=3500
FEISHU_STATE_DIR=
