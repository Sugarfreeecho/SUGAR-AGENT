#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PYTHON="$ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "SugarAgent is not installed. Run: bash \"$ROOT/scripts/install_unix.sh\"" >&2
  exit 1
fi

exec "$PYTHON" "$ROOT/app/agentctl.py" "$@"
