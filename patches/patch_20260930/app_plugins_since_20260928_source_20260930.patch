+# read_file 透明读图：命中这些扩展名时直接走附件准入，返回 [文本信封, image 块]。
+_READ_FILE_IMAGE_SUFFIXES = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp")
